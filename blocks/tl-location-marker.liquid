{% render 'tl-location-marker', block: block %}

{% schema %}
{
  "name": "TL Location Marker",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class",
      "info": "Optional CSS class name without a leading period."
    },

    {
      "type": "header",
      "content": "Location"
    },
    {
      "type": "text",
      "id": "location_name",
      "label": "Location name",
      "default": "Richmond"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 24
    },

    {
      "type": "header",
      "content": "Location icon"
    },
    {
      "type": "image_picker",
      "id": "location_icon",
      "label": "Location icon"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 10,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 60
    },

    {
      "type": "header",
      "content": "Desktop position"
    },
    {
      "type": "range",
      "id": "position_x",
      "label": "Horizontal position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "position_y",
      "label": "Vertical position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },

    {
      "type": "header",
      "content": "Mobile position"
    },
    {
      "type": "range",
      "id": "position_x_mobile",
      "label": "Horizontal position - mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "position_y_mobile",
      "label": "Vertical position - mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },

    {
      "type": "header",
      "content": "Mobile sizing"
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font size - mobile",
      "min": 8,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "label": "Icon size - mobile",
      "min": 10,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "TL Location Marker",
      "category": "Custom"
    }
  ]
}
{% endschema %}