{% render 'tl-service-card', block: block %}

{% schema %}
{
  "name": "Service Card",
  "tag": "div",
  "class": "tl-service-card-container",
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class",
      "info": "Optional custom CSS class for this card."
    },

    {
      "type": "header",
      "content": "First Card Content"
    },
    {
      "type": "text",
      "id": "card_number",
      "label": "Card number",
      "default": "01"
    },
    {
      "type": "image_picker",
      "id": "card_icon",
      "label": "Card icon"
    },
    {
      "type": "text",
      "id": "card_title",
      "label": "Card title",
      "default": "Marine Towing"
    },
    {
      "type": "color",
      "id": "first_text_color",
      "label": "Text color",
      "default": "#0F5132"
    },
    {
      "type": "color",
      "id": "first_background_color",
      "label": "Card background",
      "default": "#F4F0E6"
    },

    {
      "type": "header",
      "content": "Second Card Content"
    },
    {
      "type": "text",
      "id": "overview_label",
      "label": "Overview label",
      "default": "OVERVIEW"
    },
    {
      "type": "textarea",
      "id": "card_content",
      "label": "Card content",
      "default": "Dependable towing support for vessels in need of assistance across local waterways."
    },
    {
      "type": "color",
      "id": "second_text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "second_background_color",
      "label": "Card background",
      "default": "#145C3D"
    }
  ],
  "presets": [
    {
      "name": "Service Card",
      "category": "Custom"
    }
  ]
}
{% endschema %}

{% style %}
  .tl-service-card {
    --tl-card-radius: 0.6rem;
    --tl-card-duration: 1s;
    --tl-card-ease: cubic-bezier(0.16, 1, 0.3, 1);

    position: relative;
    display: block;
    width: 100%;
    min-width: 0;
    max-width: 290px;
    aspect-ratio: 242 / 302;

    min-height: 300px;
    max-height: 350px;


    overflow: hidden;
    border-radius: 8px;

    isolation: isolate;
  }

  .tl-service-card__layer {
    display: flex;
    flex-direction: column;

    width: 100%;
    height: 100%;

    padding: 2rem;

    border-radius: inherit;

    color: var(--tl-card-text);
    background-color: var(--tl-card-background);

    box-sizing: border-box;
  }

  .tl-service-card__overlay {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 99;
    pointer-events: none;

    background-image: url("https://cdn.shopify.com/s/files/1/0735/9889/4233/files/97518612eb1b732aaeb6a204e09185385f614ad5.png?v=1785997497");
    background-repeat: repeat;
    background-position: top center;
    object-fit: cover;
    background-size: 100%;

    opacity: 0.19;
  }

  /* ========================================================
     FRONT CARD
     ======================================================== */

  .tl-service-card__front {
    --tl-card-text: var(--tl-first-text);
    --tl-card-background: var(--tl-first-background);
    position: relative;
    z-index: 1;

    min-height: 300px;
  }

  .tl-service-card__front-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    width: 100%;

    text-align: center;
  }

  .tl-service-card__icon {
    display: block;

    width: 80px;
    height: 80px;

    margin-bottom: 24px;

    object-fit: contain;
  }

  .tl-service-card__title {
    max-width: 16rem;
    margin: 0;

    color: inherit;

    font-family: "Oscan Expanded", sans-serif;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.05;
  }

  /* ========================================================
     BACK CARD
     ======================================================== */

  .tl-service-card__back {
    --tl-card-text: var(--tl-second-text);
    --tl-card-background: var(--tl-second-background);

    position: absolute;
    inset: 0;
    z-index: 2;

    transform: translateY(100%);

    visibility: hidden;

    transition:
      transform var(--tl-card-duration) var(--tl-card-ease),
      visibility 0s linear var(--tl-card-duration);
  }

  .tl-service-card__back-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    width: 100%;

    padding: 2rem 0;

    text-align: center;
  }

  .tl-service-card__overview {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
    padding: 7px;
    color: var(--tl-second-background);
    background: var(--tl-first-background);
    border-radius: 3px;
    font-family: var(--font-body-family);
    font-size: 16px;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .tl-service-card__overview::before {
    content: "";

    display: block;

    width: 1.1rem;
    height: 1.1rem;

    flex-shrink: 0;

    background-color: var(--tl-second-background);
  }

  .tl-service-card__description {
    max-width: 24rem;
    margin: 0;

    color: inherit;

    font-family: var(--font-body-family);
    font-size: 16px;
    line-height: 1.5;
  }

  /* ========================================================
     HOVER
     ======================================================== */

  @media (hover: hover) and (pointer: fine) {
    .tl-service-card:hover .tl-service-card__back {
      transform: translateY(0);

      visibility: visible;

      transition:
        transform var(--tl-card-duration) var(--tl-card-ease),
        visibility 0s linear 0s;
    }
  }

  /* ========================================================
     REDUCED MOTION
     ======================================================== */

  @media (prefers-reduced-motion: reduce) {
    .tl-service-card__back {
      transition: none;
    }
  }

  /* ========================================================
     MOBILE
     ======================================================== */

  @media screen and (max-width: 749px) {
    .tl-service-card__layer {
      padding: 1.6rem;
    }

    .tl-service-card__icon {
      max-width: 7rem;
      margin-bottom: 2rem;
    }

    .tl-service-card__title {
      font-size: 18px;
    }

    .tl-service-card__description {
      font-size: 14px;
    }
  }

  /* ========================================================
   TOUCH + KEYBOARD INTERACTION
   ======================================================== */

  /*
  * JS-opened state.
  * Used primarily for touch and keyboard users.
  */
  .tl-service-card.is-open .tl-service-card__back {
    transform: translateY(0);
    visibility: visible;

    transition:
      transform var(--tl-card-duration) var(--tl-card-ease),
      visibility 0s linear 0s;
  }


  /*
  * Invisible native button covering the entire card.
  *
  * Gives us native keyboard support:
  * - Tab
  * - Enter
  * - Space
  */
  .tl-service-card__toggle {
    position: absolute;
    inset: 0;
    z-index: 100;

    width: 100%;
    height: 100%;

    margin: 0;
    padding: 0;

    background: transparent;
    border: 0;
    border-radius: inherit;

    cursor: pointer;

    -webkit-tap-highlight-color: transparent;
  }


  /*
  * Don't show the browser's default button outline.
  * We'll put the focus indication around the card.
  */
  .tl-service-card__toggle:focus {
    outline: none;
  }


  /*
  * Visible keyboard focus.
  */
  .tl-service-card:has(.tl-service-card__toggle:focus-visible) {
    outline: 2px solid var(--tl-first-text);
    outline-offset: 4px;
  }


  /*
  * Desktop mouse users already use hover.
  *
  * The button remains keyboard-focusable but doesn't
  * interfere with normal mouse hover behavior.
  */
  @media (hover: hover) and (pointer: fine) {
    .tl-service-card__toggle {
      pointer-events: none;
    }
  }
{% endstyle %}
<script>
  (() => {
    if (window.tlServiceCardInitialized) return;

    window.tlServiceCardInitialized = true;

    const CARD_SELECTOR = '.tl-service-card';
    const TOGGLE_SELECTOR = '.tl-service-card__toggle';
    const BACK_SELECTOR = '.tl-service-card__back';


    function setCardState(card, isOpen) {
      const toggle = card.querySelector(TOGGLE_SELECTOR);
      const back = card.querySelector(BACK_SELECTOR);

      if (!toggle || !back) return;

      card.classList.toggle('is-open', isOpen);

      toggle.setAttribute(
        'aria-expanded',
        String(isOpen)
      );

      back.setAttribute(
        'aria-hidden',
        String(!isOpen)
      );

      const label = isOpen
        ? toggle.dataset.closeLabel
        : toggle.dataset.openLabel;

      if (label) {
        toggle.setAttribute(
          'aria-label',
          label
        );
      }
    }


    /*
    * Native button automatically translates:
    *
    * Mobile tap
    * Keyboard Enter
    * Keyboard Space
    *
    * into a click event.
    */
    document.addEventListener('click', (event) => {
      const toggle = event.target.closest?.(
        TOGGLE_SELECTOR
      );

      if (!toggle) return;

      const card = toggle.closest(
        CARD_SELECTOR
      );

      if (!card) return;

      const isOpen = card.classList.contains(
        'is-open'
      );

      setCardState(
        card,
        !isOpen
      );
    });


    /*
    * Escape closes an opened card.
    */
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;

      const card = event.target.closest?.(
        CARD_SELECTOR
      );

      if (!card) return;

      if (!card.classList.contains('is-open')) {
        return;
      }

      setCardState(
        card,
        false
      );
    });
  })();
</script>